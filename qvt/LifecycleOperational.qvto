modeltype SYSML uses sysml('urn:sysml:v2:lite');
modeltype CONTINUITY uses continuity('urn:qvt:continuity');

transformation SysMLLifecycle(
  inout sysml : SYSML,
  inout continuity : CONTINUITY
);

// This transformation performs lifecycle transactions only.
// It creates and revises artifacts; ContinuityRelations.qvtr enforces and
// materializes the TraceLink objects after this operational transaction.

main() {
  sysml.objects()[StakeholderNeed]->forEach(need) {
    developIntent(need);
  };
}

operation markSuperseded(
  oldElement : LifecycleElement,
  newElement : LifecycleElement
) : OclVoid
{
  newElement.supersedes +=
    oldElement.id + '@' + oldElement.revision.toString();
}

operation developIntent(need : StakeholderNeed) : Requirement
{
  var requirementId : String := need.requirementId;
  if requirementId = null then {
    requirementId := need.id;
  } endif;

  var existing : Requirement :=
    sysml.objects()[Requirement]->select(r |
      r.id = requirementId
    )->first();

  var requirement : Requirement;
  if existing = null then {
    requirement := new SYSML::Requirement();
    requirement.id := requirementId;
    requirement.revision := 1;
  } else {
    requirement := new SYSML::Requirement();
    requirement.id := existing.id;
    requirement.revision := existing.revision + 1;
    markSuperseded(existing, requirement);
  } endif;

  requirement.statement := need.statement;
  requirement.rationale := need.rationale;
  requirement.acceptanceCriteria := need.acceptanceCriteria;
  requirement.sourceNeedId := need.id;
  return requirement;
}

operation realizeArchitecture(
  requirement : Requirement,
  elements : Sequence(ArchitectureElementSpec)
) : Sequence(ArchitecturalElement)
{
  var realized : Sequence(ArchitecturalElement);
  elements->forEach(spec) {
    var elementId : String :=
      if spec.id <> null then spec.id
      else requirement.id + '-' + spec.name.toLower()
      endif;
    var existing : ArchitecturalElement :=
      sysml.objects()[ArchitecturalElement]->select(a |
        a.id = elementId
      )->first();

    var element : ArchitecturalElement;
    if existing = null then {
      element := new SYSML::ArchitecturalElement();
      element.id := elementId;
      element.revision := 1;
    } else {
      element := existing;
      element.revision := existing.revision + 1;
      markSuperseded(existing, element);
    } endif;

    element.name := spec.name;
    element.requirementId := requirement.id;
    element.requirementRevision := requirement.revision;
    element.properties := spec.properties;
    realized += element;
  };
  return realized;
}

operation realizeInterface(
  requirement : Requirement,
  architecture : ArchitecturalElement,
  spec : InterfaceSpec
) : Interface
{
  var interfaceElement : Interface :=
    new SYSML::Interface();
  interfaceElement.id := spec.id;
  interfaceElement.revision := 1;
  interfaceElement.name := spec.name;
  interfaceElement.kind := spec.kind;
  interfaceElement.protocol := spec.protocol;
  interfaceElement.operations := spec.operations;
  interfaceElement.properties := spec.properties;
  spec.ports->forEach(portSpec) {
    realizePort(interfaceElement, portSpec);
  };
  return interfaceElement;
}

operation realizePort(
  interfaceElement : Interface,
  spec : PortSpec
) : Port
{
  var port : Port := new SYSML::Port();
  port.id := spec.id;
  port.revision := 1;
  port.name := spec.name;
  port.direction := spec.direction;
  port.kind := spec.kind;
  port.interfaceId := interfaceElement.id;
  port.protocol := spec.protocol;
  port.binding := spec.binding;
  port.properties := spec.properties;
  return port;
}

operation connectPorts(
  source : Port,
  target : Port,
  spec : ConnectionSpec
) : Connection
{
  var connection : Connection := new SYSML::Connection();
  connection.id := spec.id;
  connection.revision := 1;
  connection.sourcePortId := source.id;
  connection.targetPortId := target.id;
  connection.transport := spec.transport;
  connection.qos := spec.qos;
  connection.properties := spec.properties;
  return connection;
}

operation realizeBehavior(
  requirement : Requirement,
  architecture : Sequence(ArchitecturalElement),
  behaviorId : String,
  properties : BehaviorProperties
) : BehaviorElement
{
  var existing : BehaviorElement :=
    sysml.objects()[BehaviorElement]->select(b |
      b.id = behaviorId
    )->first();

  var behavior : BehaviorElement;
  if existing = null then {
    behavior := new SYSML::BehaviorElement();
    behavior.id := behaviorId;
    behavior.revision := 1;
  } else {
    behavior := existing;
    behavior.revision := existing.revision + 1;
    markSuperseded(existing, behavior);
  } endif;

  behavior.kind := properties.kind;
  behavior.entryPoint := properties.entryPoint;
  behavior.initialState := properties.initialState;
  behavior.states := properties.states;
  behavior.parameters := properties.parameters;
  behavior.variables := properties.variables;
  behavior.results := properties.results;
  behavior.operations := properties.operations;
  behavior.functionCalls := properties.functionCalls;
  behavior.communications := properties.communications;
  behavior.schedules := properties.schedules;
  behavior.transitions := properties.transitions;
  behavior.actions := properties.actions;
  behavior.concurrency := properties.concurrency;
  behavior.properties := properties;
  return behavior;
}

operation configureFunctionCall(
  behavior : BehaviorElement,
  spec : FunctionCallSpec
) : FunctionCall
{
  var call : FunctionCall := new SYSML::FunctionCall();
  call.id := spec.id;
  call.revision := 1;
  call.functionName := spec.functionName;
  call.target := spec.target;
  call.arguments := spec.arguments;
  call.returnBinding := spec.returnBinding;
  call.synchronous := spec.synchronous;
  call.timeoutMs := spec.timeoutMs;
  call.precondition := spec.precondition;
  call.postcondition := spec.postcondition;
  call.properties := spec.properties;
  return call;
}

operation configureCommunication(
  behavior : BehaviorElement,
  spec : CommunicationSpec
) : Communication
{
  var communication : Communication :=
    new SYSML::Communication();
  communication.id := spec.id;
  communication.revision := 1;
  communication.kind := spec.kind;
  communication.direction := spec.direction;
  communication.channel := spec.channel;
  communication.endpoint := spec.endpoint;
  communication.protocol := spec.protocol;
  communication.operation := spec.operation;
  communication.payloadType := spec.payloadType;
  communication.payloadMapping := spec.payloadMapping;
  communication.qos := spec.qos;
  communication.timeoutMs := spec.timeoutMs;
  communication.reliable := spec.reliable;
  communication.properties := spec.properties;
  return communication;
}

operation configureSchedule(
  behavior : BehaviorElement,
  spec : ScheduleSpec
) : Schedule
{
  var schedule : Schedule := new SYSML::Schedule();
  schedule.id := spec.id;
  schedule.revision := 1;
  schedule.kind := spec.kind;
  schedule.periodMs := spec.periodMs;
  schedule.startOffsetMs := spec.startOffsetMs;
  schedule.deadlineMs := spec.deadlineMs;
  schedule.wcetMs := spec.wcetMs;
  schedule.priority := spec.priority;
  schedule.jitterMs := spec.jitterMs;
  schedule.entryPoint := spec.entryPoint;
  schedule.trigger := spec.trigger;
  schedule.properties := spec.properties;
  return schedule;
}

operation allocateBehavior(
  behavior : BehaviorElement,
  target : ArchitecturalElement,
  spec : AllocationSpec
) : Allocation
{
  var allocation : Allocation := new SYSML::Allocation();
  allocation.id := spec.id;
  allocation.revision := 1;
  allocation.sourceRef := behavior.id + '@' + behavior.revision.toString();
  allocation.targetRef := target.id + '@' + target.revision.toString();
  allocation.kind := spec.kind;
  allocation.properties := spec.properties;
  return allocation;
}

operation deployComponent(
  component : LifecycleElement,
  target : LifecycleElement,
  spec : DeploymentSpec
) : Deployment
{
  var deployment : Deployment := new SYSML::Deployment();
  deployment.id := spec.id;
  deployment.revision := 1;
  deployment.componentRef := component.id + '@' + component.revision.toString();
  deployment.targetRef := target.id + '@' + target.revision.toString();
  deployment.environment := spec.environment;
  deployment.runtime := spec.runtime;
  deployment.resources := spec.resources;
  deployment.properties := spec.properties;
  return deployment;
}

operation generateImplementation(
  behavior : BehaviorElement,
  implementationId : String,
  codeGeneration : CodeGenerationSpec
) : Implementation
{
  var implementation : Implementation :=
    sysml.objects()[Implementation]->select(c |
      c.id = implementationId
    )->first();

  if implementation = null then {
    implementation := new SYSML::Implementation();
    implementation.id := implementationId;
    implementation.revision := 1;
  } else {
    implementation.revision := implementation.revision + 1;
  } endif;

  implementation.sourceBehavior := behavior.id;
  implementation.sourceBehaviorRevision := behavior.revision;
  implementation.language := codeGeneration.targetLanguage;
  implementation.targetPlatform := codeGeneration.targetPlatform;
  implementation.entryPoint := codeGeneration.entryPoint;
  implementation.buildSystem := codeGeneration.buildSystem;
  implementation.sourceFormat := codeGeneration.sourceFormat;
  implementation.behaviorModel := behavior.properties;
  implementation.codeGeneration := codeGeneration.properties;
  return implementation;
}

operation planVerification(
  requirement : Requirement,
  behavior : BehaviorElement,
  implementation : Implementation,
  spec : VerificationPlanSpec
) : VerificationPlan
{
  var plan : VerificationPlan := new SYSML::VerificationPlan();
  plan.id := spec.id;
  plan.revision := 1;
  plan.requirementRef := requirement.id + '@' + requirement.revision.toString();
  plan.behaviorRef := behavior.id + '@' + behavior.revision.toString();
  plan.implementationRef := implementation.id + '@' + implementation.revision.toString();
  plan.strategy := spec.strategy;
  plan.testLevels := spec.testLevels;
  plan.environments := spec.environments;
  plan.properties := spec.properties;
  return plan;
}

operation verifySatisfaction(
  requirement : Requirement,
  behavior : BehaviorElement,
  componentCases : Sequence(TestCase),
  simulatedScenarios : Sequence(TestCase),
  implementation : Implementation,
  plan : VerificationPlan,
  evidenceId : String,
  executionEnvironment : ExecutionEnvironment
) : VerificationEvidence
{
  componentCases->forEach(test) {
    test.requirementId := requirement.id;
    test.requirementRevision := requirement.revision;
    test.behaviorId := behavior.id;
    test.behaviorRevision := behavior.revision;
    test.implementationId := implementation.id;
    test.implementationRevision := implementation.revision;
    test.executionEnvironment := executionEnvironment;
  };

  simulatedScenarios->forEach(test) {
    test.requirementId := requirement.id;
    test.requirementRevision := requirement.revision;
    test.behaviorId := behavior.id;
    test.behaviorRevision := behavior.revision;
    test.implementationId := implementation.id;
    test.implementationRevision := implementation.revision;
    test.executionEnvironment := executionEnvironment;
  };

  var evidence : VerificationEvidence :=
    new SYSML::VerificationEvidence();
  evidence.id := evidenceId;
  evidence.revision := 1;
  evidence.requirementRef := requirement.id + '@' + requirement.revision.toString();
  evidence.behaviorRef := behavior.id + '@' + behavior.revision.toString();
  evidence.implementationRef := implementation.id + '@' + implementation.revision.toString();
  evidence.verificationPlan := plan.id + '@' + plan.revision.toString();
  evidence.executionEnvironment := executionEnvironment;
  return evidence;
}

operation propagateChange(root : LifecycleElement) : ImpactPlan
{
  var plan : ImpactPlan := new CONTINUITY::ImpactPlan();
  plan.root := root.id + '@' + root.revision.toString();
  // Traverse active traces bidirectionally.
  // The runtime adapter expands the full implementation, allocation,
  // deployment, verification-plan, and evidence closure.
  return plan;
}

operation reconcileViews(
  left : LifecycleElement,
  right : LifecycleElement
) : Reconciliation
{
  var reconciliation : Reconciliation :=
    new CONTINUITY::Reconciliation();
  if left.id = right.id
     and left.kind = right.kind
     and left.properties = right.properties then {
    reconciliation.status := 'consistent';
  } else {
    reconciliation.status := 'conflict';
  } endif;
  return reconciliation;
}

operation baselineThread(
  requirement : Requirement
) : Baseline
{
  var baseline : Baseline := new CONTINUITY::Baseline();
  baseline.requirement :=
    requirement.id + '@' + requirement.revision.toString();
  // Snapshot the undirected active trace closure for the full thread.
  return baseline;
}

operation checkContinuity(
  requirement : Requirement,
  strict : Boolean
) : Sequence(String)
{
  var diagnostics : Sequence(String);
  // The runtime adapter performs graph and executable-contract checks.
  // strict=true additionally requires implementation, allocation,
  // deployment, verification-plan, and passing evidence coverage.
  return diagnostics;
}
