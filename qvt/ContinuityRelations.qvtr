transformation SysMLContinuity(
  in sysml : SYSML,
  out continuity : CONTINUITY
) {

  // QVT-Relations owns continuity invariants and trace-link enforcement.
  // QVT-Operational creates or revises artifacts, then this relation pass
  // derives the corresponding active TraceLink objects.

  top relation ArtifactSupersession {
    domain sysml previous : LifecycleElement {
      id = previousId,
      revision = previousRevision
    };
    domain sysml replacement : LifecycleElement {
      id = replacementId,
      revision = replacementRevision,
      supersedes = supersededRefs
    };
    enforce domain continuity supersession : TraceLink {
      kind = 'supersedes',
      sourceId = previousId,
      sourceRevision = previousRevision,
      targetId = replacementId,
      targetRevision = replacementRevision,
      status = 'active'
    };
    where {
      replacementId = previousId;
      replacementRevision = previousRevision + 1;
      supersededRefs->includes(
        previousId + '@' + previousRevision.toString()
      );
    }
  }

  top relation StakeholderNeedToRequirement {
    domain sysml need : StakeholderNeed {
      id = needId,
      revision = needRevision,
      requirementId = requirementId
    };
    domain sysml requirement : Requirement {
      id = requirementId,
      revision = requirementRevision,
      sourceNeedId = needId
    };
    enforce domain continuity origin : TraceLink {
      kind = 'origin',
      sourceId = needId,
      sourceRevision = needRevision,
      targetId = requirementId,
      targetRevision = requirementRevision,
      status = 'active'
    };
  }

  top relation RequirementToArchitecture {
    domain sysml requirement : Requirement {
      id = requirementId,
      revision = requirementRevision
    };
    domain sysml architecture : ArchitecturalElement {
      id = architectureId,
      revision = architectureRevision,
      requirementId = requirementId,
      requirementRevision = requirementRevision
    };
    enforce domain continuity realization : TraceLink {
      kind = 'realizes',
      sourceId = requirementId,
      sourceRevision = requirementRevision,
      targetId = architectureId,
      targetRevision = architectureRevision,
      status = 'active'
    };
  }

  top relation ArchitectureToInterfaceAndPort {
    domain sysml architecture : ArchitecturalElement {
      id = architectureId,
      revision = architectureRevision
    };
    domain sysml interface : Interface {
      id = interfaceId,
      revision = interfaceRevision,
      protocol = protocolName,
      operations = operations,
      ports = ports
    };
    domain sysml port : Port {
      id = portId,
      revision = portRevision,
      interfaceId = interfaceId,
      direction = portDirection,
      protocol = protocolName
    };
    enforce domain continuity exposure : TraceLink {
      kind = 'exposes',
      sourceId = architectureId,
      sourceRevision = architectureRevision,
      targetId = interfaceId,
      targetRevision = interfaceRevision,
      status = 'active'
    };
    enforce domain continuity portExposure : TraceLink {
      kind = 'exposes',
      sourceId = interfaceId,
      sourceRevision = interfaceRevision,
      targetId = portId,
      targetRevision = portRevision,
      status = 'active'
    };
  }

  top relation PortToPortConnection {
    domain sysml sourcePort : Port {
      id = sourcePortId,
      revision = sourcePortRevision
    };
    domain sysml targetPort : Port {
      id = targetPortId,
      revision = targetPortRevision
    };
    domain sysml connection : Connection {
      id = connectionId,
      revision = connectionRevision,
      sourcePortId = sourcePortId,
      targetPortId = targetPortId,
      transport = transportName,
      qos = qosProperties
    };
    enforce domain continuity sourceConnection : TraceLink {
      kind = 'connects',
      sourceId = sourcePortId,
      sourceRevision = sourcePortRevision,
      targetId = connectionId,
      targetRevision = connectionRevision,
      status = 'active'
    };
    enforce domain continuity targetConnection : TraceLink {
      kind = 'connects',
      sourceId = connectionId,
      sourceRevision = connectionRevision,
      targetId = targetPortId,
      targetRevision = targetPortRevision,
      status = 'active'
    };
  }

  top relation ArchitectureToBehavior {
    domain sysml architecture : ArchitecturalElement {
      id = architectureId,
      revision = architectureRevision
    };
    domain sysml behavior : BehaviorElement {
      id = behaviorId,
      revision = behaviorRevision,
      kind = behaviorKind,
      entryPoint = entryPointName,
      initialState = initialStateName,
      states = states,
      parameters = parameters,
      variables = variables,
      results = results,
      operations = operations,
      functionCalls = functionCalls,
      communications = communications,
      schedules = schedules,
      transitions = transitions,
      actions = actions,
      concurrency = concurrencyMode
    };
    enforce domain continuity support : TraceLink {
      kind = 'supports',
      sourceId = architectureId,
      sourceRevision = architectureRevision,
      targetId = behaviorId,
      targetRevision = behaviorRevision,
      status = 'active'
    };
  }

  top relation BehaviorFunctionCall {
    domain sysml behavior : BehaviorElement {
      id = behaviorId,
      revision = behaviorRevision,
      functionCalls = functionCalls
    };
    domain sysml call : FunctionCall {
      id = callId,
      revision = callRevision,
      functionName = functionName,
      target = callTarget,
      arguments = arguments,
      returnBinding = returnBinding,
      synchronous = synchronous,
      timeoutMs = timeoutMs
    };
    enforce domain continuity callTrace : TraceLink {
      kind = 'calls',
      sourceId = behaviorId,
      sourceRevision = behaviorRevision,
      targetId = callId,
      targetRevision = callRevision,
      status = 'active'
    };
  }

  top relation BehaviorCommunication {
    domain sysml behavior : BehaviorElement {
      id = behaviorId,
      revision = behaviorRevision,
      communications = communications
    };
    domain sysml communication : Communication {
      id = communicationId,
      revision = communicationRevision,
      kind = communicationKind,
      direction = communicationDirection,
      channel = channel,
      endpoint = endpoint,
      protocol = protocolName,
      payloadType = payloadType,
      qos = qosProperties,
      timeoutMs = timeoutMs,
      reliable = reliable
    };
    enforce domain continuity communicationTrace : TraceLink {
      kind = 'connects',
      sourceId = behaviorId,
      sourceRevision = behaviorRevision,
      targetId = communicationId,
      targetRevision = communicationRevision,
      status = 'active'
    };
  }

  top relation BehaviorSchedule {
    domain sysml behavior : BehaviorElement {
      id = behaviorId,
      revision = behaviorRevision,
      schedules = schedules
    };
    domain sysml schedule : Schedule {
      id = scheduleId,
      revision = scheduleRevision,
      kind = scheduleKind,
      periodMs = periodMs,
      deadlineMs = deadlineMs,
      wcetMs = wcetMs,
      priority = priority,
      jitterMs = jitterMs,
      entryPoint = entryPointName
    };
    enforce domain continuity scheduleTrace : TraceLink {
      kind = 'schedules',
      sourceId = behaviorId,
      sourceRevision = behaviorRevision,
      targetId = scheduleId,
      targetRevision = scheduleRevision,
      status = 'active'
    };
  }

  top relation BehaviorToAllocation {
    domain sysml behavior : BehaviorElement {
      id = behaviorId,
      revision = behaviorRevision
    };
    domain sysml architecture : ArchitecturalElement {
      id = targetId,
      revision = targetRevision
    };
    domain sysml allocation : Allocation {
      id = allocationId,
      revision = allocationRevision,
      sourceRef = behaviorId,
      targetRef = targetId,
      kind = allocationKind,
      properties = allocationProperties
    };
    enforce domain continuity allocationTrace : TraceLink {
      kind = 'allocates',
      sourceId = behaviorId,
      sourceRevision = behaviorRevision,
      targetId = targetId,
      targetRevision = targetRevision,
      status = 'active'
    };
  }

  top relation ComponentToDeployment {
    domain sysml component : LifecycleElement {
      id = componentId,
      revision = componentRevision
    };
    domain sysml target : LifecycleElement {
      id = targetId,
      revision = targetRevision
    };
    domain sysml deployment : Deployment {
      id = deploymentId,
      revision = deploymentRevision,
      componentRef = componentId,
      targetRef = targetId,
      environment = environmentName,
      runtime = runtimeName,
      resources = resources
    };
    enforce domain continuity deploymentTrace : TraceLink {
      kind = 'deployed_to',
      sourceId = componentId,
      sourceRevision = componentRevision,
      targetId = targetId,
      targetRevision = targetRevision,
      status = 'active'
    };
  }

  top relation BehaviorToImplementation {
    domain sysml behavior : BehaviorElement {
      id = behaviorId,
      revision = behaviorRevision,
      functionCalls = functionCalls,
      communications = communications,
      schedules = schedules
    };
    domain sysml implementation : Implementation {
      id = implementationId,
      revision = implementationRevision,
      sourceBehavior = behaviorId,
      sourceBehaviorRevision = behaviorRevision,
      language = languageName,
      targetPlatform = targetPlatform,
      entryPoint = entryPointName,
      buildSystem = buildSystem,
      behaviorModel = behaviorModel,
      codeGeneration = codeGenerationProperties
    };
    enforce domain continuity generation : TraceLink {
      kind = 'generates',
      sourceId = behaviorId,
      sourceRevision = behaviorRevision,
      targetId = implementationId,
      targetRevision = implementationRevision,
      status = 'active'
    };
    enforce domain continuity implementation : TraceLink {
      kind = 'implements',
      sourceId = implementationId,
      sourceRevision = implementationRevision,
      targetId = behaviorId,
      targetRevision = behaviorRevision,
      status = 'active'
    };
  }

  top relation VerificationPlanToEvidence {
    domain sysml requirement : Requirement {
      id = requirementId,
      revision = requirementRevision
    };
    domain sysml behavior : BehaviorElement {
      id = behaviorId,
      revision = behaviorRevision
    };
    domain sysml plan : VerificationPlan {
      id = planId,
      revision = planRevision,
      requirementRef = requirementId,
      behaviorRef = behaviorId,
      strategy = strategyName,
      testLevels = testLevels,
      environments = environments
    };
    domain sysml evidence : VerificationEvidence {
      id = evidenceId,
      revision = evidenceRevision,
      result = 'pass',
      verificationPlan = planId,
      executionEnvironment = executionEnvironment
    };
    enforce domain continuity planCoverage : TraceLink {
      kind = 'covers',
      sourceId = planId,
      sourceRevision = planRevision,
      targetId = requirementId,
      targetRevision = requirementRevision,
      status = 'active'
    };
    enforce domain continuity planVerification : TraceLink {
      kind = 'verifies',
      sourceId = planId,
      sourceRevision = planRevision,
      targetId = evidenceId,
      targetRevision = evidenceRevision,
      status = 'active'
    };
  }

  top relation TestToRequirementAndBehavior {
    domain sysml test : TestCase {
      id = testId,
      revision = testRevision,
      requirementId = requirementId,
      requirementRevision = requirementRevision,
      behaviorId = behaviorId,
      behaviorRevision = behaviorRevision,
      implementationId = implementationId,
      implementationRevision = implementationRevision,
      executionEnvironment = executionEnvironment
    };
    enforce domain continuity coverage : TraceLink {
      kind = 'covers',
      sourceId = testId,
      sourceRevision = testRevision,
      targetId = requirementId,
      targetRevision = requirementRevision,
      status = 'active'
    };
    enforce domain continuity execution : TraceLink {
      kind = 'executes',
      sourceId = testId,
      sourceRevision = testRevision,
      targetId = behaviorId,
      targetRevision = behaviorRevision,
      status = 'active'
    };
    enforce domain continuity implementationExecution : TraceLink {
      kind = 'executes',
      sourceId = testId,
      sourceRevision = testRevision,
      targetId = implementationId,
      targetRevision = implementationRevision,
      status = 'active'
    };
  }
}
