<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.github.michaellrowley</groupId>
  <artifactId>sysml-v2-qvt-continuity</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <lsp4j.version>0.24.0</lsp4j.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j</artifactId>
      <version>${lsp4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.common</artifactId>
      <version>2.45.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore</artifactId>
      <version>2.43.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
      <version>2.40.0</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.runtime</artifactId>
      <version>3.35.0</version>
    </dependency>
    <dependency>
      <groupId>lpg.runtime</groupId>
      <artifactId>java</artifactId>
      <version>2.0.17-v201004271640</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Eclipse QVT Operational and the MDT OCL runtime are downloaded by
         scripts/download-qvt-libs.sh. -->
    <dependency>
      <groupId>org.eclipse.qvto</groupId>
      <artifactId>qvt-oml-core</artifactId>
      <version>3.11.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.m2m.qvt.oml_3.11.2.v20260216-1113.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.qvto</groupId>
      <artifactId>qvt-oml-runtime</artifactId>
      <version>3.11.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.m2m.qvt.oml.runtime_3.11.0.v20260216-1113.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.qvto</groupId>
      <artifactId>qvt-oml-common</artifactId>
      <version>3.11.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.m2m.qvt.oml.common_3.11.0.v20260216-1113.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.qvto</groupId>
      <artifactId>qvt-oml-cst-parser</artifactId>
      <version>3.11.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.m2m.qvt.oml.cst.parser_3.11.2.v20260216-1113.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.qvto</groupId>
      <artifactId>qvt-oml-emf-util</artifactId>
      <version>3.11.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.m2m.qvt.oml.emf.util_3.11.0.v20260216-1113.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.qvto</groupId>
      <artifactId>qvt-oml-imperativeocl</artifactId>
      <version>3.11.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.m2m.qvt.oml.ecore.imperativeocl_3.11.0.v20260216-1113.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.ocl</groupId>
      <artifactId>ocl-runtime</artifactId>
      <version>3.24.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.ocl_3.24.0.v20260601-1413.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.ocl</groupId>
      <artifactId>ocl-common</artifactId>
      <version>1.24.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.ocl.common_1.24.0.v20260601-1413.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.ocl</groupId>
      <artifactId>ocl-ecore</artifactId>
      <version>3.24.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/org.eclipse.ocl.ecore_3.24.0.v20260601-1413.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>unpack-eclipse-qvt-libraries</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <unzip src="${project.basedir}/lib/org.eclipse.m2m.qvt.oml_3.11.2.v20260216-1113.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.basedir}/lib/org.eclipse.m2m.qvt.oml.runtime_3.11.0.v20260216-1113.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.basedir}/lib/org.eclipse.m2m.qvt.oml.common_3.11.0.v20260216-1113.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.basedir}/lib/org.eclipse.m2m.qvt.oml.cst.parser_3.11.2.v20260216-1113.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.basedir}/lib/org.eclipse.m2m.qvt.oml.emf.util_3.11.0.v20260216-1113.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.basedir}/lib/org.eclipse.m2m.qvt.oml.ecore.imperativeocl_3.11.0.v20260216-1113.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.basedir}/lib/org.eclipse.ocl_3.24.0.v20260601-1413.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.basedir}/lib/org.eclipse.ocl.common_1.24.0.v20260601-1413.jar" dest="${project.build.outputDirectory}"/>
                <unzip src="${project.basedir}/lib/org.eclipse.ocl.ecore_3.24.0.v20260601-1413.jar" dest="${project.build.outputDirectory}"/>
                <delete>
                  <fileset dir="${project.build.outputDirectory}/META-INF">
                    <include name="*.SF"/>
                    <include name="*.DSA"/>
                    <include name="*.RSA"/>
                    <include name="*.EC"/>
                    <include name="ECLIPSE*.RSA"/>
                    <include name="ECLIPSE*.SF"/>
                  </fileset>
                </delete>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.github.michaellrowley.sysmlqvt.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
